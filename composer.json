{
    "name": "icecaster/silverstripe-cms-mcp",
    "type": "silverstripe-vendormodule",
    "description": "Exposes SilverStripe CMS content (fields, file uploads, draft/publish workflow) to AI agents via the Model Context Protocol (MCP).",
    "license": "BSD-3-Clause",
    "keywords": ["silverstripe", "cms", "mcp", "model-context-protocol", "ai", "agent"],
    "authors": [
        {
            "name": "Icecaster"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5.3",
        "silverstripe/cms": "^5.3",
        "silverstripe/versioned": "^2.3",
        "silverstripe/assets": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "extra": {
        "expose": [
            "client-config"
        ]
    },
    "autoload": {
        "psr-4": {
            "Icecaster\\CmsMcp\\": "src/",
            "Icecaster\\CmsMcp\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}

{
    "name": "flxlabs/silverstripe-cms-mcp",
    "type": "silverstripe-vendormodule",
    "description": "Exposes SilverStripe CMS content (fields, file uploads, draft/publish workflow) to AI agents via the Model Context Protocol (MCP).",
    "license": "BSD-3-Clause",
    "keywords": [
        "silverstripe",
        "cms",
        "mcp",
        "model-context-protocol",
        "ai",
        "agent"
    ],
    "authors": [
        {
            "name": "FLX Labs"
        },
        {
            "name": "Icecaster"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6",
        "silverstripe/versioned": "^3",
        "silverstripe/assets": "^3"
    },
    "extra": {
        "expose": [
            "client-config"
        ]
    },
    "autoload": {
        "psr-4": {
            "FLXLabs\\CmsMcp\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
